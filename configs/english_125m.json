{
  "schema_version": 1,
  "name": "english_125m",
  "dataset_pointer": "data/processed/CURRENT_PRETRAINING.json",
  "model": {
    "vocab_size": 32000,
    "hidden_size": 768,
    "intermediate_size": 2080,
    "num_hidden_layers": 14,
    "num_attention_heads": 12,
    "num_key_value_heads": 12,
    "max_position_embeddings": 1024,
    "rms_norm_eps": 0.00001,
    "rope_parameters": {"rope_type": "default", "rope_theta": 10000.0},
    "attention_dropout": 0.0,
    "attention_bias": false,
    "mlp_bias": false,
    "tie_word_embeddings": true,
    "use_cache": false,
    "bos_token_id": 3,
    "eos_token_id": 1,
    "pad_token_id": 0
  },
  "training": {
    "seed": 42,
    "sequence_length": 1024,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 8,
    "precision": "bf16",
    "learning_rate": 0.0003,
    "minimum_learning_rate": 0.00003,
    "warmup_updates": 1000,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "adam_epsilon": 1e-8,
    "gradient_clip": 1.0,
    "num_workers": 2,
    "prefetch_factor": 2,
    "gradient_checkpointing": false,
    "log_every_updates": 10,
    "mini_validation_every_updates": 1000,
    "mini_validation_tokens": 1048576,
    "full_validation_every_updates": 10000,
    "checkpoint_every_updates": 1000,
    "keep_latest_checkpoints": 3,
    "max_epochs": 1,
    "max_tokens": 2636654462,
    "output_root": "runs/train_125m",
    "attention_policy": "causal; source-local blocks; EOS marks documents but does not reset attention"
  }
}
