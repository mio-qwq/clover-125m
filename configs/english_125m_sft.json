{
  "schema_version": 1,
  "stage": "english_full_sft",
  "base_model_dir": "runs/sft_inputs/english125m_base_20261015_v1/model",
  "base_manifest": "runs/sft_inputs/english125m_base_20261015_v1/manifest.json",
  "base_pretraining_config": "configs/english_125m.json",
  "dataset_pointer": "data/processed/CURRENT_SFT.json",
  "model": {
    "vocab_size": 32000,
    "hidden_size": 768,
    "intermediate_size": 2080,
    "num_hidden_layers": 14,
    "num_attention_heads": 12,
    "num_key_value_heads": 12,
    "max_position_embeddings": 1024,
    "rms_norm_eps": 0.00001,
    "rope_parameters": {"rope_type": "default", "rope_theta": 10000.0},
    "attention_dropout": 0.0,
    "attention_bias": false,
    "mlp_bias": false,
    "tie_word_embeddings": true,
    "use_cache": false,
    "bos_token_id": 3,
    "eos_token_id": 1,
    "pad_token_id": 0
  },
  "training": {
    "seed": 42,
    "sequence_length": 512,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 8,
    "precision": "bf16",
    "learning_rate": 0.00002,
    "minimum_learning_rate": 0.000002,
    "warmup_ratio": 0.05,
    "weight_decay": 0.01,
    "betas": [0.9, 0.95],
    "adam_epsilon": 0.00000001,
    "gradient_clip": 1.0,
    "num_workers": 2,
    "prefetch_factor": 2,
    "gradient_checkpointing": false,
    "max_epochs": 1,
    "eval_every_updates": 100,
    "retention_every_updates": 500,
    "retention_max_tokens": 1048576,
    "checkpoint_every_updates": 100,
    "log_every_updates": 10,
    "keep_latest_checkpoints": 2,
    "output_root": "runs/sft_125m",
    "attention_policy": "causal; one conversation per sequence; right padding masked; no cross-conversation packing",
    "loss_policy": "already-shifted assistant content plus EOS targets; sum CE divided by accumulated assistant target count"
  }
}
